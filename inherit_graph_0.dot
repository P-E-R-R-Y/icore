digraph "Graphical Class Hierarchy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  rankdir="LR";
  Node0 [id="Node000000",label="ICore",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classICore.html",tooltip="Ca se lance, ca rend un code de sortie. Pas forcement une boucle."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="IApp",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classIApp.html",tooltip="Une application a boucle. Elle tourne seule, ou se fait ticker."];
  Node2 [id="Node000002",label="ITickable",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classITickable.html",tooltip="Ce qui se fait ticker par quelqu'un d'autre, frame par frame."];
  Node2 -> Node1 [id="edge2_Node000002_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
}
