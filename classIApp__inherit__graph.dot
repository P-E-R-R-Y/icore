digraph "IApp"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="IApp",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Une application a boucle. Elle tourne seule, ou se fait ticker."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="ICore",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classICore.html",tooltip="Ca se lance, ca rend un code de sortie. Pas forcement une boucle."];
  Node3 -> Node1 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="ITickable",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classITickable.html",tooltip="Ce qui se fait ticker par quelqu'un d'autre, frame par frame."];
}
